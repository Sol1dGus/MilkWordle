# Скопируй в .env и заполни из Discord Developer Portal
# https://discord.com/developers/applications

# Application ID (OAuth2 -> Client ID) — публичный, идет в клиент
VITE_CLIENT_ID=

# Client Secret (OAuth2 -> Client Secret) — только для сервера, никому не показывай
CLIENT_SECRET=

# Порт игрового сервера (npm start / npm run server)
PORT=3001
